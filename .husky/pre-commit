#!/bin/sh

# Run lint-staged for JS files
npx lint-staged

# Check if any Rust files are staged
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ -n "$RUST_FILES" ]; then
    echo "🦀 Formatting Rust files with cargo fmt..."
    
    # Use cargo fmt which respects edition from Cargo.toml
    cargo fmt --all
    
    # Re-add the formatted files
    for file in $RUST_FILES; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
    
    echo "✅ Rust formatting complete"
fi
