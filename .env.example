# Letta MCP Server Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Letta API Base URL
# The URL where your Letta server is running
# Examples:
#   - Local: http://localhost:8283
#   - Production: https://api.letta.com
LETTA_BASE_URL=http://localhost:8283

# ============================================================================
# TRANSPORT CONFIGURATION
# ============================================================================

# Transport mode: stdio or http
# - stdio: For Claude Desktop, Cursor, etc. (default)
# - http: For production deployments with HTTP transport
TRANSPORT=stdio

# HTTP Server Port (only used when TRANSPORT=http)
# Default: 6507
# Valid range: 1024-65535
PORT=6507

# ============================================================================
# AUTHENTICATION (Optional)
# ============================================================================

# Letta API Authentication
# Uncomment and set if your Letta server requires authentication

# Bearer token authentication
# LETTA_API_TOKEN=your-api-token-here

# Basic authentication
# LETTA_API_USER=your-username
# LETTA_API_PASSWORD=your-password

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Rust log level
# Options: error, warn, info, debug, trace
# Default: info
RUST_LOG=info

# Enable backtraces on panic
# Options: 0 (disabled), 1 (enabled), full (full backtrace)
# Default: 0
RUST_BACKTRACE=0

# ============================================================================
# PERFORMANCE TUNING (Advanced)
# ============================================================================

# Request timeout in seconds
# Default: 30
# REQUEST_TIMEOUT=30

# Max concurrent requests
# Default: 100
# MAX_CONCURRENT_REQUESTS=100

# Connection pool size for Letta API
# Default: 10
# CONNECTION_POOL_SIZE=10

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================

# Enable experimental features
# EXPERIMENTAL_FEATURES=false

# Enable detailed error responses (dev only)
# DETAILED_ERRORS=false

# ============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# ============================================================================

# Development
# LETTA_BASE_URL=http://localhost:8283
# TRANSPORT=stdio
# RUST_LOG=debug
# RUST_BACKTRACE=1

# Staging
# LETTA_BASE_URL=https://staging-api.letta.com
# TRANSPORT=http
# PORT=6507
# RUST_LOG=info
# LETTA_API_TOKEN=staging-token

# Production
# LETTA_BASE_URL=https://api.letta.com
# TRANSPORT=http
# PORT=6507
# RUST_LOG=warn
# LETTA_API_TOKEN=prod-token
# RUST_BACKTRACE=0
